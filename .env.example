# Moagan environment template.
# Copy to .env and fill in real values. Never commit .env.

# Provider API key resolved by the CLI. Required for live LLM calls.
# The key is read from environment, never from CLI flags.
MINIMAX_API_KEY=

# Optional: override the default run/artifact directory.
# Default: ~/.local/share/moagan
# MOAGAN_HOME=/home/<user>/.local/share/moagan

# Optional: log filter. Default: info,moagan=debug
# RUST_LOG=info,moagan=debug

# Optional: explicit provider endpoint override (defaults to https://api.minimax.io/anthropic/v1).
# MOAGAN_MINIMAX_ENDPOINT=https://api.minimax.io/anthropic/v1
